        { "id": "none" }
      ],
      "drifted": ["new"]
    },
    {
      "name": "an empty purposes list drifts nothing",
      "at": "2026-01-01T00:00:00.000Z",
      "purposes": [],
      "drifted": []
    },
    {
      "name": "atServer is preferred over a device clock skewed into the future",
      "at": "2099-01-01T00:00:00.000Z",
