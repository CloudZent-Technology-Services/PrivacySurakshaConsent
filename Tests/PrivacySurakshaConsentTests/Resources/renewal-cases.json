    { "name": "exactly at the boundary is not yet expired", "at": "2026-02-04T00:00:00.000Z", "validityDays": 180, "expired": false },
    { "name": "one millisecond past the boundary is expired", "at": "2026-02-03T23:59:59.999Z", "validityDays": 180, "expired": true },
    { "name": "zero validity fails closed", "at": "2026-08-03T00:00:00.000Z", "validityDays": 0, "expired": true },
    { "name": "negative validity fails closed", "at": "2026-08-03T00:00:00.000Z", "validityDays": -5, "expired": true }
  ],
  "drift": [
