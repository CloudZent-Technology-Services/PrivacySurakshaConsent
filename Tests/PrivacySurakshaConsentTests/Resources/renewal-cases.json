      "drifted": ["a"]
    },
    {
      "name": "an exactly equal timestamp does not drift, the comparison is strict",
      "at": "2026-03-01T00:00:00.000Z",
      "purposes": [{ "id": "a", "materialSince": "2026-03-01T00:00:00.000Z" }],
      "drifted": []
    },
    {
      "name": "only the drifted subset is returned",
      "at": "2026-02-01T00:00:00.000Z",
